<!--
  底部主导航：Tab 展示由 utils/session-state 的唯一用户状态决定。
  - tabLoading：状态未确认，渲染等高占位，避免首屏闪出完整 Tab 再收回；
  - minimalTabs：只展示「恋爱广场」+「我的」；
  - 完整状态：展示项目原有的完整 Tab 结构与顺序。
-->
<view class="bottom-nav">
  <view wx:if="{{tabLoading}}" class="nav-bar nav-bar-skeleton" aria-role="progressbar" aria-label="正在确认登录状态">
    <view class="nav-skeleton-item"></view>
    <view class="nav-skeleton-item"></view>
    <view class="nav-skeleton-item"></view>
    <view class="nav-skeleton-item"></view>
    <view class="nav-skeleton-item"></view>
  </view>

  <view wx:else class="nav-bar">
    <view class="nav-side nav-side-left">
      <view wx:if="{{showPlaza}}" class="nav-item {{current === 'plaza' ? 'is-active' : ''}}" data-page="plaza" bindtap="navigate" hover-class="nav-hover" aria-role="button" aria-label="恋爱广场">
        <view class="nav-icon plaza-icon"><view class="plaza-ring"></view><view class="plaza-ring plaza-ring-second"></view></view><text class="nav-label">广场</text>
      </view>
      <view wx:if="{{showStory}}" class="nav-item {{current === 'story' ? 'is-active' : ''}}" data-page="story" bindtap="navigate" hover-class="nav-hover" aria-role="button" aria-label="故事">
        <text class="nav-icon story-icon">✦</text><text class="nav-label">故事</text>
      </view>
      <view wx:if="{{showPhoto}}" class="nav-item {{current === 'photo' ? 'is-active' : ''}}" data-page="photo" bindtap="navigate" hover-class="nav-hover" aria-role="button" aria-label="相册">
        <text class="nav-icon photo-icon">▣</text><text class="nav-label">相册</text>
      </view>
    </view>

    <view wx:if="{{showHome}}" class="nav-item home-item {{current === 'home' ? 'is-active' : ''}}" data-page="home" bindtap="navigate" hover-class="home-hover" aria-role="button" aria-label="首页">
      <view class="home-logo"><image class="logo-image" src="/images/amour-logo.svg" mode="aspectFit"></image></view><text class="nav-label home-label">首页</text>
    </view>
    <!-- 无情侣空间时不展示品牌入口，用等宽占位保持两侧 Tab 均分，避免布局跳动。 -->
    <view wx:else class="home-placeholder"></view>

    <view class="nav-side nav-side-right">
      <view wx:if="{{showMessage}}" class="nav-item {{current === 'message' ? 'is-active' : ''}}" data-page="message" bindtap="navigate" hover-class="nav-hover" aria-role="button" aria-label="留言">
        <text class="nav-icon message-icon">♡</text><text class="nav-label">留言</text>
      </view>
      <view wx:if="{{showProfile}}" class="nav-item {{current === 'profile' ? 'is-active' : ''}}" data-page="profile" bindtap="navigate" hover-class="nav-hover" aria-role="button" aria-label="我的">
        <view class="profile-icon"><view class="profile-head"></view><view class="profile-body"></view></view><text class="nav-label">我的</text>
      </view>
    </view>
  </view>
</view>

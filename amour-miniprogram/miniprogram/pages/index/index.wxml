<navigation-bar title="首页" back="{{false}}" color="#572c37" background="#fcf8f5"></navigation-bar>

<scroll-view class="page-scroll" scroll-y bounces="{{false}}" type="list" enhanced show-scrollbar="false">
  <view wx:if="{{pageBlocked}}" class="page-blocked">
    <view class="state-spinner"></view>
    <text class="state-text">正在确认情侣空间状态…</text>
  </view>

  <view wx:else class="home-page">
    <view wx:if="{{homeLoading && !homeLoaded}}" class="state-card">
      <view class="state-spinner"></view>
      <text class="state-text">正在读取空间信息…</text>
    </view>

    <!-- 首次加载失败：给出可见说明与重试，而不是只写日志 -->
    <view wx:elif="{{homeError && !homeLoaded}}" class="error-card">
      <text class="error-title">空间信息加载失败</text>
      <text class="error-note">{{homeError}}</text>
      <button class="primary-button" bindtap="onRetryHome" hover-class="button-hover">重新加载</button>
    </view>

    <block wx:else>
      <!-- 已有内容后的刷新失败：保留页面内容，只提供轻量重试 -->
      <view wx:if="{{refreshError}}" class="refresh-band">
        <view class="refresh-copy">
          <text class="refresh-title">刷新失败，正在展示上次的内容</text>
          <text class="refresh-note">{{refreshError}}</text>
        </view>
        <button class="retry-button" bindtap="onRetryHome" loading="{{refreshing}}" disabled="{{refreshing}}">{{refreshing ? '重试中…' : '重试'}}</button>
      </view>

      <!-- ==================== 首页主视觉 ==================== -->
      <view class="hero-section">
        <view class="hero-copy">
          <view class="eyebrow">
            <text class="eyebrow-dot"></text>
            <text>{{boyName}} · {{girlName}} / OUR LITTLE UNIVERSE</text>
          </view>
          <text class="hero-title">把普通的日子，</text>
          <text class="hero-title hero-title-accent">过成两个人的纪念册</text>
          <text class="hero-description">从相遇的那一刻起，时间有了温度，日常也有了值得反复翻阅的意义。</text>

          <view class="hero-actions">
            <button wx:if="{{showStory}}" class="primary-button" data-section="story" bindtap="openSection" hover-class="button-hover">
              <text>翻阅我们的故事</text><text class="button-arrow">→</text>
            </button>
            <button wx:if="{{showPhoto}}" class="secondary-button" data-section="photo" bindtap="openSection" hover-class="button-hover">
              <text>看看恋爱相册</text><text class="button-arrow">→</text>
            </button>
          </view>
        </view>

        <view class="hero-visual">
          <view class="orbit orbit-large"></view>
          <view class="orbit orbit-small"></view>

          <block wx:if="{{homePhotos.length}}">
            <view class="photo-frame photo-frame-main" data-index="0" bindtap="onPreviewPhoto" hover-class="photo-hover">
              <image
                wx:if="{{homePhotos[0] && !homePhotos[0].failed}}"
                class="hero-photo"
                src="{{homePhotos[0].url}}"
                data-index="0"
                data-source="primary"
                mode="aspectFill"
                lazy-load="true"
                binderror="onPhotoError"
              ></image>
              <view wx:elif="{{homePhotos[0]}}" class="hero-photo hero-photo-failed">
                <text class="photo-placeholder-heart">♥</text>
                <text class="photo-placeholder-title">照片暂时无法显示</text>
                <text class="photo-placeholder-note">可到「编辑空间」重新上传</text>
              </view>
              <view class="photo-caption">
                <text class="caption-label">OUR FAVORITE</text>
                <text class="caption-title">Love in every frame</text>
                <text class="caption-heart">♥</text>
              </view>
            </view>

            <view class="photo-frame photo-frame-small" data-index="1" bindtap="onPreviewPhoto" hover-class="photo-hover">
              <image
                wx:if="{{homePhotos[1] && !homePhotos[1].failed}}"
                class="hero-photo"
                src="{{homePhotos[1].url}}"
                data-index="1"
                data-source="secondary"
                mode="aspectFill"
                lazy-load="true"
                binderror="onPhotoError"
              ></image>
              <view wx:elif="{{homePhotos[1]}}" class="hero-photo hero-photo-failed">
                <text class="photo-placeholder-heart">♥</text>
                <text class="photo-placeholder-note">照片暂时无法显示</text>
              </view>
              <view wx:else class="hero-photo hero-photo-placeholder">
                <text class="photo-placeholder-plus">＋</text>
                <text class="photo-placeholder-note">再加一张照片</text>
              </view>
            </view>
          </block>

          <block wx:else>
            <view class="photo-frame photo-frame-main" data-index="0" bindtap="onPreviewPhoto" hover-class="photo-hover">
              <view class="hero-photo hero-photo-placeholder">
                <text class="photo-placeholder-heart">♥</text>
                <text class="photo-placeholder-title">还没有首页照片</text>
                <text class="photo-placeholder-note">上传两张照片，让空间更像你们。</text>
                <text wx:if="{{canEdit}}" class="photo-placeholder-link" bindtap="onEditSpace">去上传</text>
              </view>
              <view class="photo-caption">
                <text class="caption-label">OUR FAVORITE</text>
                <text class="caption-title">等待你们的照片</text>
                <text class="caption-heart">♥</text>
              </view>
            </view>
            <view class="photo-frame photo-frame-small">
              <view class="hero-photo hero-photo-placeholder">
                <text class="photo-placeholder-plus">＋</text>
                <text class="photo-placeholder-note">第二张照片</text>
              </view>
            </view>
          </block>

          <view class="together-badge">
            <view class="avatar-stack">
              <image wx:if="{{boyAvatar}}" class="mini-avatar" src="{{boyAvatar}}" mode="aspectFill" binderror="onAvatarError" data-source="boy"></image>
              <view wx:else class="mini-avatar avatar-fallback">{{boyInitial}}</view>
              <view
                wx:if="{{waitingForPartner}}"
                class="mini-avatar mini-avatar-overlap avatar-waiting"
                bindtap="onOpenInvite"
                hover-class="avatar-hover"
                aria-role="button"
                aria-label="邀请另一半加入"
              >＋</view>
              <block wx:else>
                <image wx:if="{{girlAvatar}}" class="mini-avatar mini-avatar-overlap" src="{{girlAvatar}}" mode="aspectFill" binderror="onAvatarError" data-source="girl"></image>
                <view wx:else class="mini-avatar mini-avatar-overlap avatar-fallback">{{girlInitial}}</view>
              </block>
            </view>
            <view class="together-copy">
              <text class="together-label">TOGETHER</text>
              <text class="together-days">{{togetherDays}} DAYS</text>
            </view>
          </view>

          <view wx:if="{{hasLoveStart}}" class="since-note">
            <text class="since-label">SINCE</text>
            <text class="since-date">{{loveStartDate}}</text>
          </view>
        </view>
      </view>

      <!-- ==================== 在一起的时间 ==================== -->
      <view class="time-section">
        <view class="section-heading">
          <view>
            <text class="section-kicker">OUR TIME</text>
            <text class="section-title">我们已经一起走过</text>
          </view>
          <text class="section-aside">每一秒都值得被记住</text>
        </view>

        <block wx:if="{{hasLoveStart}}">
          <view class="time-grid">
            <view class="time-unit" wx:for="{{elapsedUnits}}" wx:key="label">
              <text class="time-value">{{item.value}}</text>
              <text class="time-label">{{item.label}}</text>
            </view>
          </view>
          <text class="time-since">从 {{loveStartDate}} 开始</text>
        </block>
        <view wx:else class="time-empty">
          <text class="time-empty-title">尚未设置开始时间</text>
          <text class="time-empty-note">设置后，这里会显示你们一起走过的每一天。</text>
          <button wx:if="{{canEdit}}" class="secondary-button small" bindtap="onEditSpace" hover-class="button-hover">去设置</button>
        </view>
      </view>

      <!-- ==================== 常用内容入口 ==================== -->
      <view class="explore-section">
        <view class="section-heading explore-heading">
          <view>
            <text class="section-kicker">OUR CORNERS</text>
            <text class="section-title">收藏每一种心动</text>
          </view>
          <text class="section-aside">故事、照片和想对彼此说的话</text>
        </view>

        <view class="quick-grid">
          <view wx:if="{{showStory}}" class="quick-card quick-card-story" data-section="story" bindtap="openSection" hover-class="card-hover" aria-role="button" aria-label="查看我们的故事">
            <view class="card-icon">✦</view>
            <text class="card-title">我们的故事</text>
            <text class="card-description">沿着时间线，重温一路走来的重要章节。</text>
            <text class="card-link">{{storyStat}} <text>→</text></text>
          </view>
          <view wx:if="{{showPhoto}}" class="quick-card quick-card-photo" data-section="photo" bindtap="openSection" hover-class="card-hover" aria-role="button" aria-label="打开恋爱相册">
            <view class="card-icon">◫</view>
            <text class="card-title">恋爱相册</text>
            <text class="card-description">把旅行、日常和彼此的笑容装进同一本相册。</text>
            <text class="card-link">打开相册 <text>→</text></text>
          </view>
          <view wx:if="{{showMessage}}" class="quick-card quick-card-note" data-section="message" bindtap="openSection" hover-class="card-hover" aria-role="button" aria-label="打开悄悄话">
            <view class="card-icon">♡</view>
            <text class="card-title">悄悄话</text>
            <text class="card-description">写下此刻想说的话，让温柔一直有迹可循。</text>
            <text class="card-link">留一句话 <text>→</text></text>
          </view>
          <view wx:if="{{showAnniversary}}" class="quick-card quick-card-anniversary" bindtap="onOpenAnniversary" hover-class="card-hover" aria-role="button" aria-label="管理纪念日">
            <view class="card-icon">♥</view>
            <text class="card-title">纪念日</text>
            <text class="card-description">把重要的日子记下来，不再错过每一次庆祝。</text>
            <text class="card-link">{{canEdit ? '管理纪念日' : '空间设置后可管理'}} <text>→</text></text>
          </view>
        </view>

        <view wx:if="{{!showStory && !showPhoto && !showMessage && !showAnniversary}}" class="empty-state">
          <text class="empty-title">暂无内容入口</text>
          <text class="empty-note">当前账号还没有内容查询权限，请联系管理员开通。</text>
        </view>
      </view>

      <view class="quote-section">
        <text class="quote-mark">“</text>
        <text class="quote-text">时间会把答案写在我们一起走过的每一天里。</text>
        <text class="quote-author">— FOR US, ALWAYS</text>
      </view>
    </block>

    <view class="safe-bottom"></view>
  </view>
</scroll-view>

<bottom-nav current="home"></bottom-nav>

<navigation-bar title="恋爱相册" back="{{false}}" color="#572c37" background="#fcf8f5"></navigation-bar>

<scroll-view class="page-scroll" scroll-y type="list" enhanced show-scrollbar="false" lower-threshold="120" bindscrolltolower="loadMore">
  <view class="photo-page">
    <view class="page-hero">
      <text class="hero-kicker">OUR PHOTO BOOK</text>
      <text class="hero-title">翻开属于我们的相册</text>
      <text class="hero-copy">收藏走过的地方、见过的光，还有每一个刚好有彼此的瞬间。</text>
      <view class="album-summary"><text class="summary-value">{{total}}</text><text class="summary-label">张照片，仍在继续增加</text></view>
    </view>

    <view class="filter-section">
      <view class="section-heading"><view><text class="section-kicker">COLLECTIONS</text><text class="section-title">照片分类</text></view><text class="section-meta">{{pageSummary}}</text></view>
      <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="false">
        <view class="filter-list">
          <view class="filter-chip {{activeCategory === 'all' ? 'is-active' : ''}}" data-id="all" bindtap="selectCategory">全部</view>
          <view wx:for="{{categories}}" wx:key="id" class="filter-chip {{activeCategory === item.id ? 'is-active' : ''}}" data-id="{{item.id}}" bindtap="selectCategory">{{item.categoryName}}</view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{loading}}" class="photo-grid loading-grid"><view class="photo-skeleton" wx:for="{{loadingItems}}" wx:key="*this"></view></view>

    <view wx:elif="{{loadError}}" class="empty-state"><text class="state-symbol">!</text><text class="state-title">相册暂时打不开</text><text class="state-copy">{{loadError}}</text><button class="outline-button" bindtap="retry">重新加载</button></view>

    <view wx:elif="{{photos.length}}" class="photo-grid">
      <view class="photo-card" wx:for="{{photos}}" wx:key="id" data-index="{{index}}" bindtap="openPhotoDetail" hover-class="card-hover" aria-role="button" aria-label="查看照片详情 {{item.title}}">
        <view class="photo-frame"><image class="photo-image" src="{{item.url}}" mode="aspectFill" lazy-load="true"></image><text class="photo-number">{{item.number}}</text></view>
        <view class="photo-copy"><text class="photo-title">{{item.title}}</text><text class="photo-category">{{item.categoryName}}</text><text class="photo-description">{{item.description}}</text><view class="photo-meta"><text>{{item.date}}</text><text wx:if="{{item.location}}">⌖ {{item.location}}</text></view></view>
      </view>
    </view>

    <view wx:else class="empty-state"><text class="state-symbol">□</text><text class="state-title">这里还没有照片</text><text class="state-copy">新的回忆会慢慢装满这里。</text></view>

    <view wx:if="{{photos.length}}" class="load-more-status">
      <text wx:if="{{loadingMore}}" class="load-more-text">正在加载更多回忆…</text>
      <view wx:elif="{{loadMoreError}}" class="load-more-error"><text>{{loadMoreError}}</text><button class="load-more-button" bindtap="retryLoadMore">重试</button></view>
      <text wx:elif="{{hasMore}}" class="load-more-text">继续上滑，加载更多</text>
      <text wx:else class="load-more-text">已经看完所有照片</text>
    </view>
    <view class="safe-bottom"></view>
  </view>
</scroll-view>
<bottom-nav current="photo"></bottom-nav>

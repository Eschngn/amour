<navigation-bar title="我的" back="{{false}}" color="#623640" background="#fcf8f5"></navigation-bar>

<scroll-view class="page-scroll" scroll-y bounces="{{false}}" type="list" enhanced show-scrollbar="false">
  <view class="profile-page">
    <!-- 状态确认中：骨架占位，不短暂展示任何需要情侣空间的内容 -->
    <block wx:if="{{statusLoading}}">
      <view class="profile-skeleton">
        <view class="skeleton-avatar"></view>
        <view class="skeleton-copy"><view class="skeleton-line wide"></view><view class="skeleton-line"></view></view>
      </view>
      <view class="skeleton-card"></view>
      <view class="skeleton-card short"></view>
    </block>

    <block wx:else>
      <view wx:if="{{authenticating}}" class="login-progress"><view class="login-progress-bar"></view></view>

      <!-- 账号摘要：未登录时展示登录引导，已登录时展示资料入口 -->
      <view class="account-summary" bindtap="onAccountTap" hover-class="account-summary-hover">
        <view class="avatar-wrap">
          <text wx:if="{{!avatar || avatarError}}" class="avatar-initial">{{initial}}</text>
          <image wx:else class="avatar-image" src="{{avatar}}" mode="aspectFill" binderror="onAvatarError"></image>
        </view>
        <view class="account-copy">
          <text class="display-name">{{loggedIn ? displayName : '尚未登录'}}</text>
          <text class="username">{{loggedIn ? (username ? '@' + username : '账号信息已同步') : '微信登录后可创建情侣空间'}}</text>
        </view>
        <view class="edit-chevron" aria-role="button" aria-label="{{loggedIn ? '编辑个人资料' : '微信登录'}}">{{loggedIn ? '›' : '登录'}}</view>
      </view>

      <!-- 未登录：登录入口 + 说明 -->
      <view wx:if="{{!loggedIn}}" class="login-panel">
        <view class="login-copy">
          <text class="login-title">登录后开启情侣空间</text>
          <text class="login-note">登录即可创建属于你们两个人的空间，把故事、照片和悄悄话都收在一起。</text>
        </view>
        <button class="primary-button" bindtap="onLogin" loading="{{loggingIn}}" disabled="{{loggingIn}}" hover-class="button-hover">{{loggingIn ? '正在登录…' : '微信登录'}}</button>
      </view>

      <!-- 已登录但没有可用情侣空间：创建 / 绑定引导（核心需求） -->
      <view wx:elif="{{!hasSpace}}" class="space-guide {{spaceStateError ? 'has-error' : ''}}">
        <view class="space-guide-head">
          <view class="space-guide-icon">
            <text wx:if="{{spaceStateError}}">!</text>
            <text wx:else>♡</text>
          </view>
          <view class="space-guide-copy">
            <text class="space-guide-title">{{spaceStateTitle}}</text>
            <text class="space-guide-note">{{spaceStateNote}}</text>
          </view>
        </view>
        <view wx:if="{{spaceStateError}}" class="space-guide-actions">
          <button class="primary-button" bindtap="onRetrySession" loading="{{authenticating}}" hover-class="button-hover">重新查询状态</button>
          <button class="secondary-button" bindtap="onCreateSpace" hover-class="button-hover">仍然创建情侣空间</button>
        </view>
        <block wx:else>
          <view class="space-guide-actions">
            <button class="primary-button" bindtap="onCreateSpace" hover-class="button-hover">创建情侣空间</button>
            <button class="secondary-button" bindtap="onBindSpace" hover-class="button-hover">绑定 / 加入情侣空间</button>
          </view>
          <text class="space-guide-tip">创建或绑定成功后，故事、相册、留言等完整功能会自动开启。</text>
        </block>
      </view>

      <!-- 已有情侣空间：展示空间摘要与入口 -->
      <view wx:else class="space-card">
        <view class="space-card-head">
          <view class="space-card-icon">♥</view>
          <view class="space-card-copy">
            <text class="space-card-title">{{spaceName}}</text>
            <text class="space-card-note">{{spaceSummary}}</text>
          </view>
        </view>
        <button class="secondary-button" bindtap="onOpenSpace" hover-class="button-hover">进入情侣空间</button>
      </view>

      <!-- 账号同步错误提示 -->
      <view wx:if="{{loginError || sessionError}}" class="error-band">
        <view class="error-copy">
          <text class="error-title">{{loggedIn ? '状态同步失败' : '登录失败'}}</text>
          <text class="error-note">{{loginError || sessionError}}</text>
        </view>
        <button class="retry-button" bindtap="onRetrySession" loading="{{authenticating}}">重试</button>
      </view>

      <view class="settings-section">
        <text class="section-title">账号安全</text>
        <view class="settings-list">
          <view class="settings-row {{(!loggedIn || authenticating) ? 'is-disabled' : ''}}" bindtap="openPasswordModal" hover-class="settings-row-hover">
            <view class="lock-icon"><view class="lock-shackle"></view><view class="lock-body"><view></view></view></view>
            <view class="settings-copy"><text class="settings-title">{{passwordSet ? '修改密码' : '设置密码'}}</text><text class="settings-note">{{passwordSet ? '需验证当前密码' : '设置后可在网页端使用用户名登录'}}</text></view>
            <text class="row-status">{{passwordSet ? '已设置' : '未设置'}}</text><text class="row-chevron">›</text>
          </view>
        </view>
      </view>

      <view wx:if="{{loggedIn}}" class="logout-section">
        <button class="logout-button" bindtap="requestLogout" loading="{{loggingOut}}" disabled="{{loggingOut}}" hover-class="logout-hover">{{loggingOut ? '正在退出…' : '退出登录'}}</button>
      </view>

      <view class="safe-bottom"></view>
    </block>
  </view>
</scroll-view>
<bottom-nav current="profile"></bottom-nav>

<view wx:if="{{passwordModalOpen}}" class="modal-mask" bindtap="closePasswordModal">
  <view
    class="password-sheet"
    style="transform: translateY({{passwordSheetOffset}}rpx); transition: {{passwordSheetTransition}};"
    catchtap="stopPropagation"
  >
    <view
      class="sheet-handle"
      catchtouchstart="onSheetTouchStart"
      catchtouchmove="onSheetTouchMove"
      catchtouchend="onSheetTouchEnd"
    ></view>
    <view class="sheet-header"><view class="sheet-copy"><text class="sheet-title">{{passwordSet ? '修改密码' : '设置密码'}}</text><text class="sheet-note">{{passwordSet ? '验证当前密码后进行更新' : '密码长度需为 6-64 个字符'}}</text></view></view>
    <form bindsubmit="onPasswordSubmit">
      <view wx:if="{{passwordSet}}" class="password-field"><text class="field-label">当前密码</text><input class="password-input" password maxlength="64" confirm-type="next" adjust-position value="{{passwordForm.current}}" placeholder="请输入当前密码" data-field="current" bindinput="onPasswordInput" /></view>
      <view class="password-field"><text class="field-label">新密码</text><input class="password-input" password maxlength="64" confirm-type="next" adjust-position value="{{passwordForm.next}}" placeholder="6-64 个字符" data-field="next" bindinput="onPasswordInput" /></view>
      <view class="password-field"><text class="field-label">确认新密码</text><input class="password-input" password maxlength="64" confirm-type="done" adjust-position value="{{passwordForm.confirm}}" placeholder="请再次输入新密码" data-field="confirm" bindinput="onPasswordInput" /></view>
      <button class="password-submit" form-type="submit" loading="{{passwordSaving}}" disabled="{{passwordSaving}}">{{passwordSaving ? '正在保存' : (passwordSet ? '确认更新' : '确认设置')}}</button>
    </form>
  </view>
</view>

<block wx:if="{{false}}">
<navigation-bar title="我的" back="{{false}}" color="#4f4650" background="#faf9f7"></navigation-bar>

<scroll-view class="page-scroll" scroll-y bounces="{{false}}" type="list" enhanced show-scrollbar="false">
  <view class="profile-page">
    <view class="profile-hero">
      <view class="avatar-picker" catchtap="openProfileEditor">
        <view class="avatar-wrap {{avatarUploading ? 'is-uploading' : ''}}">
          <text wx:if="{{!avatar || avatarError}}" class="avatar-initial">{{initial}}</text>
          <image wx:else class="avatar-image" src="{{avatar}}" mode="aspectFill" binderror="onAvatarError"></image>
          <view wx:if="{{avatarUploading}}" class="avatar-uploading"><view class="avatar-spinner"></view></view>
        </view>
      </view>
      <text class="display-name" catchtap="openProfileEditor" hover-class="nickname-hover">{{displayName}}</text>
      <view class="account-state">
        <view class="state-dot {{loggedIn ? 'is-online' : ''}}"></view>
        <text>{{accountState}}</text>
      </view>
    </view>

    <view class="auth-band {{loginError ? 'has-error' : ''}}">
      <view class="auth-status-icon">
        <view wx:if="{{authenticating}}" class="auth-spinner"></view>
        <text wx:elif="{{loginError}}">!</text>
        <text wx:elif="{{loggedIn}}">✓</text>
        <view wx:else class="wechat-mark"><view></view><view></view></view>
      </view>
      <view class="auth-copy">
        <text class="auth-title">{{authTitle}}</text>
        <text class="auth-note">{{loginError || authNote}}</text>
      </view>
      <button
        wx:if="{{!authenticating && (!loggedIn || loginError)}}"
        class="login-button"
        bindtap="retryLogin"
        hover-class="button-hover"
        loading="{{authenticating}}"
      >{{loginError ? '重试' : '微信登录'}}</button>
    </view>

    <view class="profile-section">
      <text class="section-kicker">MY AMOUR</text>
      <text class="section-title">个人空间</text>
      <view class="setting-list">
        <view class="setting-row">
          <view class="setting-icon heart-icon">♡</view>
          <view class="setting-copy">
            <text class="setting-title">相伴时光</text>
            <text class="setting-note">收藏属于两个人的生活记录</text>
          </view>
        </view>
        <view
          class="setting-row {{(!loggedIn || loginError) ? 'is-actionable' : ''}}"
          bindtap="handleAccountAction"
          hover-class="{{(!loggedIn || loginError) ? 'row-hover' : 'none'}}"
        >
          <view class="setting-icon account-icon"><view class="mini-profile-icon"><view></view><view></view></view></view>
          <view class="setting-copy">
            <text class="setting-title">账号信息</text>
            <text class="setting-note">{{loggedIn ? accountLabel : '等待微信登录'}}</text>
          </view>
          <text wx:if="{{!loggedIn || loginError}}" class="setting-arrow">›</text>
          <view wx:else class="row-check">✓</view>
        </view>
        <view class="setting-row">
          <view class="setting-icon shield-icon"><view class="shield-mark">✓</view></view>
          <view class="setting-copy">
            <text class="setting-title">会话安全</text>
            <text class="setting-note">会话密钥仅由服务端保管</text>
          </view>
        </view>
      </view>

    </view>
    <view class="safe-bottom"></view>
  </view>
</scroll-view>
<bottom-nav current="profile"></bottom-nav>
</block>

<navigation-bar title="我的" back="{{false}}" color="#3f393d" background="#f7f6f4"></navigation-bar>

<scroll-view class="page-scroll" scroll-y bounces="{{false}}" type="list" enhanced show-scrollbar="false">
  <view class="profile-page">
    <view wx:if="{{authenticating}}" class="login-progress"><view class="login-progress-bar"></view></view>
    <view class="account-summary" bindtap="openProfileEditor" hover-class="account-summary-hover">
      <view class="avatar-wrap">
        <text wx:if="{{!avatar || avatarError}}" class="avatar-initial">{{initial}}</text>
        <image wx:else class="avatar-image" src="{{avatar}}" mode="aspectFill" binderror="onAvatarError"></image>
      </view>
      <view class="account-copy">
        <text class="display-name">{{displayName}}</text>
        <text class="username">{{username ? '@' + username : (authenticating ? '正在同步账号' : '账号信息未就绪')}}</text>
      </view>
      <view class="edit-chevron" aria-role="button" aria-label="编辑个人资料">›</view>
    </view>
    <view wx:if="{{loginError}}" class="error-band">
      <view class="error-copy"><text class="error-title">账号同步失败</text><text class="error-note">{{loginError}}</text></view>
      <button class="retry-button" bindtap="retryLogin" loading="{{authenticating}}">重试</button>
    </view>
    <view class="settings-section">
      <text class="section-title">账号安全</text>
      <view class="settings-list">
        <view class="settings-row {{(!loggedIn || authenticating) ? 'is-disabled' : ''}}" bindtap="openPasswordModal" hover-class="settings-row-hover">
          <view class="lock-icon"><view class="lock-shackle"></view><view class="lock-body"><view></view></view></view>
          <view class="settings-copy"><text class="settings-title">{{passwordSet ? '修改密码' : '设置密码'}}</text><text class="settings-note">{{passwordSet ? '需验证当前密码' : '设置后可在网页端使用用户名登录'}}</text></view>
          <text class="row-status">{{passwordSet ? '已设置' : '未设置'}}</text><text class="row-chevron">›</text>
        </view>
      </view>
    </view>
    <view class="safe-bottom"></view>
  </view>
</scroll-view>
<bottom-nav current="profile"></bottom-nav>

<view wx:if="{{passwordModalOpen}}" class="modal-mask" bindtap="closePasswordModal">
  <view
    class="password-sheet"
    style="transform: translateY({{passwordSheetOffset}}rpx); transition: {{passwordSheetTransition}};"
    catchtap="stopPropagation"
    catchtouchstart="onSheetTouchStart"
    catchtouchmove="onSheetTouchMove"
    catchtouchend="onSheetTouchEnd"
  >
    <view class="sheet-handle"></view>
    <view class="sheet-header"><view class="sheet-copy"><text class="sheet-title">{{passwordSet ? '修改密码' : '设置密码'}}</text><text class="sheet-note">{{passwordSet ? '验证当前密码后进行更新' : '密码长度需为 6-64 个字符'}}</text></view></view>
    <form bindsubmit="onPasswordSubmit">
      <view wx:if="{{passwordSet}}" class="password-field"><text class="field-label">当前密码</text><input class="password-input" password maxlength="64" value="{{passwordForm.current}}" placeholder="请输入当前密码" data-field="current" bindinput="onPasswordInput" /></view>
      <view class="password-field"><text class="field-label">新密码</text><input class="password-input" password maxlength="64" value="{{passwordForm.next}}" placeholder="6-64 个字符" data-field="next" bindinput="onPasswordInput" /></view>
      <view class="password-field"><text class="field-label">确认新密码</text><input class="password-input" password maxlength="64" value="{{passwordForm.confirm}}" placeholder="请再次输入新密码" data-field="confirm" bindinput="onPasswordInput" /></view>
      <button class="password-submit" form-type="submit" loading="{{passwordSaving}}" disabled="{{passwordSaving}}">{{passwordSaving ? '正在保存' : (passwordSet ? '确认更新' : '确认设置')}}</button>
    </form>
  </view>
</view>

<navigation-bar title="我的" back="{{false}}" color="#4f4650" background="#faf9f7"></navigation-bar>

<scroll-view class="page-scroll" scroll-y bounces="{{false}}" type="list" enhanced show-scrollbar="false">
  <view class="profile-page">
    <view class="profile-hero">
      <view class="avatar-picker" bindtap="handleAvatarTap">
        <view class="avatar-wrap {{avatarUploading ? 'is-uploading' : ''}}">
          <text wx:if="{{!avatar || avatarError}}" class="avatar-initial">{{initial}}</text>
          <image wx:else class="avatar-image" src="{{avatar}}" mode="aspectFill" binderror="onAvatarError"></image>
          <view wx:if="{{avatarUploading}}" class="avatar-uploading"><view class="avatar-spinner"></view></view>
        </view>
        <button
          wx:if="{{!avatarUploading}}"
          class="avatar-picker-button"
          open-type="chooseAvatar"
          bindchooseavatar="onWechatAvatarChosen"
          disabled="{{!loggedIn || loginError}}"
        ></button>
      </view>
      <text class="display-name" bindtap="openNicknameEditor" hover-class="nickname-hover">{{displayName}}</text>
      <view class="account-state">
        <view class="state-dot {{loggedIn ? 'is-online' : ''}}"></view>
        <text>{{accountState}}</text>
      </view>
    </view>

    <view class="auth-band {{loginError ? 'has-error' : ''}}">
      <view class="auth-status-icon">
        <view wx:if="{{authenticating}}" class="auth-spinner"></view>
        <text wx:elif="{{loginError}}">!</text>
        <text wx:elif="{{loggedIn}}">✓</text>
        <view wx:else class="wechat-mark"><view></view><view></view></view>
      </view>
      <view class="auth-copy">
        <text class="auth-title">{{authTitle}}</text>
        <text class="auth-note">{{loginError || authNote}}</text>
      </view>
      <button
        wx:if="{{!authenticating && (!loggedIn || loginError)}}"
        class="login-button"
        bindtap="retryLogin"
        hover-class="button-hover"
        loading="{{authenticating}}"
      >{{loginError ? '重试' : '微信登录'}}</button>
    </view>

    <view class="profile-section">
      <text class="section-kicker">MY AMOUR</text>
      <text class="section-title">个人空间</text>
      <view class="setting-list">
        <view class="setting-row">
          <view class="setting-icon heart-icon">♡</view>
          <view class="setting-copy">
            <text class="setting-title">相伴时光</text>
            <text class="setting-note">收藏属于两个人的生活记录</text>
          </view>
        </view>
        <view
          class="setting-row {{(!loggedIn || loginError) ? 'is-actionable' : ''}}"
          bindtap="handleAccountAction"
          hover-class="{{(!loggedIn || loginError) ? 'row-hover' : 'none'}}"
        >
          <view class="setting-icon account-icon"><view class="mini-profile-icon"><view></view><view></view></view></view>
          <view class="setting-copy">
            <text class="setting-title">账号信息</text>
            <text class="setting-note">{{loggedIn ? accountLabel : '等待微信登录'}}</text>
          </view>
          <text wx:if="{{!loggedIn || loginError}}" class="setting-arrow">›</text>
          <view wx:else class="row-check">✓</view>
        </view>
        <view class="setting-row">
          <view class="setting-icon shield-icon"><view class="shield-mark">✓</view></view>
          <view class="setting-copy">
            <text class="setting-title">会话安全</text>
            <text class="setting-note">会话密钥仅由服务端保管</text>
          </view>
        </view>
      </view>

      <button
        wx:if="{{loggedIn}}"
        class="logout-button"
        bindtap="requestLogout"
        loading="{{loggingOut}}"
        disabled="{{authenticating || loggingOut}}"
        hover-class="logout-hover"
      ><text class="logout-icon">↪</text><text>{{loggingOut ? '正在退出' : '退出登录'}}</text></button>
    </view>
    <view class="safe-bottom"></view>
  </view>
</scroll-view>
<view wx:if="{{nicknameEditorVisible}}" class="nickname-modal-mask" catchtap="closeNicknameEditor">
  <view class="nickname-modal" catchtap="stopNicknameTap">
    <text class="nickname-modal-title">设置昵称</text>
    <text class="nickname-modal-note">输入时可使用微信昵称</text>
    <form bindsubmit="submitNickname">
      <input
        class="nickname-input"
        name="nickname"
        type="nickname"
        value="{{nicknameDraft}}"
        maxlength="20"
        placeholder="请输入昵称"
        bindinput="onNicknameInput"
        cursor-spacing="160"
        adjust-position="true"
        confirm-type="done"
      />
      <button class="nickname-submit" form-type="submit" loading="{{nicknameSaving}}" disabled="{{nicknameSaving}}">保存</button>
    </form>
    <button class="nickname-cancel" bindtap="closeNicknameEditor" disabled="{{nicknameSaving}}">取消</button>
  </view>
</view>
<bottom-nav current="profile"></bottom-nav>
